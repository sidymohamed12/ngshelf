{
  "name": "ngshelf",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev/lancer.ts",
    "start:site": "ng serve ngshelf",
    "start:apercus": "ng serve apercus",
    "build": "ng build ngshelf && ng build apercus && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dist/assembler.ts",
    "verifier:dist": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dist/verifier.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:dev": "ng build --configuration development",
    "lint": "ng lint",
    "registre:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/registre/construire.ts",
    "prestart": "npm run registre:build",
    "prestart:site": "npm run registre:build",
    "prestart:apercus": "npm run registre:build",
    "prebuild": "npm run registre:build",
    "prebuild:dev": "npm run registre:build",
    "prewatch": "npm run registre:build",
    "pretest": "npm run registre:build",
    "prelint": "npm run registre:build"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  }
}
