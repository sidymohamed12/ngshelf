    },
    {
      "nom": "unite",
      "type": "input<string>()",
      "defaut": "''",
      "role": "Unité affichée après la valeur."
    },
    {
      "nom": "min / max / pas",
      "type": "input<number>()",
      "defaut": "0 / 100 / 1",
      "role": "Bornes et pas."
    },
    {
      "nom": "valeur",
      "type": "model<number>()",
      "defaut": "50",
      "role": "Valeur, liable en [(valeur)]."
    }
  ]
